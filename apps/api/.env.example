# Copy to .env and adjust. Every variable is validated at startup (src/config/env.schema.ts).
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/auth-app
# At least 32 bytes. Generate one with: openssl rand -base64 32
JWT_SECRET=replace-me-with-the-output-of-openssl-rand-base64-32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_TOKEN_ABSOLUTE_TTL_SECONDS=2592000
WEB_ORIGIN=http://localhost:5173
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=true
TRUST_PROXY_HOPS=0
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=5
ACCOUNT_THROTTLE_LIMIT=10
LOG_LEVEL=info
# Defaults to false when NODE_ENV=production
SWAGGER_ENABLED=true
