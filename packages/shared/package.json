{
  "name": "@auth-app/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Validation schemas and API contract types shared by the API and the web app",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
